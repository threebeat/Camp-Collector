{
  "name": "camp-collector",
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "test": "node --test tests/*.test.js",
    "dev": "npm run build && node scripts/dev.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run validate",
    "format": "prettier --write web worker scripts tests/e2e playwright.config.js"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  }
}
